DATABASE_URL="postgresql://postgres@localhost:5432/nova_ops"
# Migrations use DIRECT_URL. Locally it is the same database; on Supabase, DATABASE_URL is the
# transaction pooler (:6543, ?pgbouncer=true&connection_limit=1) and DIRECT_URL the session pooler (:5432).
DIRECT_URL="postgresql://postgres@localhost:5432/nova_ops"
MOCK_API_BASE_URL="http://127.0.0.1:8765"
